PORT=3000
NODE_ENV=development
OPENAI_API_KEY=your_openai_api_key_here

# Optional Postgres persistence (leave empty to use in-memory fallback)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/salesbrain
DATABASE_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

BRAIN_CACHE_TTL=300
MAX_CONVERSATION_HISTORY=20

# Used when DATABASE_URL is not set
API_KEYS=my_shop:replace_with_secure_key,business_123:key_abc123,business_456:key_def456

WHATSAPP_VERIFY_TOKEN=replace_with_verify_token
WHATSAPP_APP_SECRET=replace_with_app_secret
WHATSAPP_ACCESS_TOKEN=replace_with_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_PHONE_BUSINESS_MAP=replace_with_phone_number_id:my_shop
WHATSAPP_DEFAULT_BUSINESS_ID=my_shop
WEBHOOK_DEDUPE_TTL_SECONDS=300
WHATSAPP_API_VERSION=v20.0
